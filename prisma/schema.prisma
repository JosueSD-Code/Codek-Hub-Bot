generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id              String            @id
  name            String?
  icon            String?
  ownerId         String?
  logChannelId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  panels          TicketPanel[]
  welcomeConfig   WelcomeConfig?
  vouchConfig     VouchConfig?
  presenceConfig  PresenceConfig?
  autoResponders  AutoResponder[]
  auditLogs       AuditLog[]
  moderationActions ModerationAction[]
  logConfig       LogConfig?
  giveaways       Giveaway[]
  autoModRules    AutoModRule[]
  ticketStats     TicketStats[]
}

model TicketPanel {
  id          String          @id @default(cuid())
  guildId     String
  guild       Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  channelId   String
  title       String?
  description String?
  color       String?
  image       String?
  thumbnail   String?
  footer      String?
  active      Boolean         @default(true)
  categories  TicketCategory[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@unique([guildId, name])
  @@index([guildId, name])
}

model TicketCategory {
  id                String          @id @default(cuid())
  panelId           String
  panel             TicketPanel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  emoji             String?
  supportRoleIds    String[]
  discordCategoryId String?
  questions         TicketQuestion[]
  tickets           Ticket[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@unique([panelId, name])
  @@index([panelId, name])
}

model TicketQuestion {
  id          String         @id @default(cuid())
  categoryId  String
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label       String
  placeholder String?
  required    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  @@unique([categoryId, label])
  @@index([categoryId, label])
}

model Ticket {
  id           String           @id @default(cuid())
  guildId      String
  categoryId   String?
  categoryName String?
  category     TicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId       String
  channelId    String           @unique
  number       Int
  status       String           @default("open")
  claimedById  String?
  createdAt    DateTime         @default(now())
  closedAt     DateTime?
  closedReason String?
  priority     String   @default("normal")
  claimedAt    DateTime?
  answers      TicketAnswer[]
  claims       TicketClaim[]
  transcript   TicketTranscript?
  @@unique([guildId, categoryId, number])
  @@index([guildId, status])
  @@index([guildId, userId, status])
  @@index([categoryId, status])
}

model TicketAnswer {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label    String
  answer   String
}

model TicketClaim {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  @@index([ticketId, userId])
}

model TicketTranscript {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  html      String
  createdAt DateTime @default(now())
}

model WelcomeConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  channelId   String?
  message     String?
  title       String?
  description String?
  color       String?
  image       String?
  thumbnail   String?
  footer      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goodbyeEnabled Boolean @default(false)
  goodbyeChannelId String?
  goodbyeMessage String?
}

model VouchConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(false)
  channelId     String?
  allowedRoleIds String[]
  cooldown      Int      @default(60)
  title         String?
  description   String?
  color         String?
  image         String?
  thumbnail     String?
  footer        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vouch {
  id         String   @id @default(cuid())
  guildId    String
  targetId   String
  reviewerId String
  reviewType String
  rating     Int
  text       String
  createdAt  DateTime @default(now())
  @@unique([guildId, targetId, reviewerId])
  @@index([guildId, targetId, createdAt])
  @@index([guildId, reviewerId, createdAt])
}

model AutoResponder {
  id               String   @id @default(cuid())
  guildId          String
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  trigger           String
  response          String
  matchType         String   @default("contains")
  embedTitle        String?
  embedDescription  String?
  embedColor        String?
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([guildId, trigger])
  @@index([guildId, enabled, trigger])
}

model PresenceConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  type      String   @default("Watching")
  text      String   @default("Codek Hub")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  module    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  @@index([guildId, createdAt])
  @@index([guildId, module, action])
}

model ModerationAction {
  id          String   @id @default(uuid())
  guildId     String
  guild       Guild    @relation(fields:[guildId],references:[id],onDelete:Cascade)
  targetId    String
  moderatorId String
  action      String
  reason      String?
  duration    Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  @@index([guildId,targetId])
  @@index([createdAt])
}

model LogConfig {
  guildId   String   @id
  guild      Guild    @relation(fields:[guildId],references:[id],onDelete:Cascade)
  channelId String
  events    LogEvent[]
}

enum LogEvent {
  MESSAGE_DELETE
  MESSAGE_EDIT
  MEMBER_JOIN
  MEMBER_LEAVE
  MEMBER_UPDATE
  ROLE_CREATE
  ROLE_DELETE
  ROLE_UPDATE
  CHANNEL_CREATE
  CHANNEL_DELETE
  CHANNEL_UPDATE
  MODERATION
  TICKET_CREATE
  TICKET_CLOSE
  TICKET_CLAIM
  COMMAND
}

model Giveaway {
  id           String   @id @default(uuid())
  guildId      String
  guild        Guild    @relation(fields:[guildId],references:[id],onDelete:Cascade)
  channelId    String
  messageId    String
  prize        String
  winners      Int
  endsAt       DateTime
  createdBy    String
  participants String[]
  ended        Boolean  @default(false)
  winnerIds    String[]
  createdAt    DateTime @default(now())
  @@index([guildId,ended,endsAt])
}

model AutoModRule {
  id         String   @id @default(uuid())
  guildId    String
  guild      Guild    @relation(fields:[guildId],references:[id],onDelete:Cascade)
  type       String
  enabled    Boolean  @default(true)
  action     String   @default("delete")
  threshold  Int?
  durationSeconds Int?
  whitelist  String[]
  exceptions String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([guildId,type])
  @@index([guildId,enabled])
}

model TicketStats {
  id         String   @id @default(uuid())
  guildId    String
  guild      Guild    @relation(fields:[guildId],references:[id],onDelete:Cascade)
  userId     String?
  staffId    String?
  categoryId String?
  action     String
  timestamp  DateTime @default(now())
  duration   Int?
  @@index([guildId,timestamp])
  @@index([guildId,action])
}
