generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id             String          @id @db.VarChar(32)
  name           String?
  icon           String?
  ownerId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  config         GuildConfig?
  ticketPanels   TicketPanel[]
  welcomeConfig  WelcomeConfig?
  vouchConfig    VouchConfig?
  automodConfig  AutoModConfig?
  antispamConfig AntiSpamConfig?
  antiraidConfig AntiRaidConfig?
  autoresponders AutoResponder[]
  logConfig      LogConfig?
  auditLogs      AuditLog[]
}

model GuildConfig {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  guild               Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticketsEnabled      Boolean  @default(false)
  welcomeEnabled      Boolean  @default(false)
  vouchEnabled        Boolean  @default(false)
  richPresenceEnabled Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TicketPanel {
  id          String         @id @default(cuid())
  guildId     String
  guild       Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  channelId   String
  description String?
  active      Boolean        @default(true)
  categories  TicketCategory[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TicketCategory {
  id          String      @id @default(cuid())
  panelId     String
  panel       TicketPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  emoji       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TicketQuestion {
  id          String   @id @default(cuid())
  guildId     String
  question    String
  type        String
  required    Boolean  @default(false)
  placeholder String?
  minLength   Int?
  maxLength   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id         String       @id @default(cuid())
  guildId    String
  category   String
  userId     String
  channelId  String
  status     String       @default("open")
  priority   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  claim      TicketClaim?
  transcript Transcript?
}

model TicketClaim {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId   String
  claimedAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Transcript {
  id        String    @id @default(cuid())
  ticketId  String    @unique
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  html      String
  createdAt DateTime  @default(now())
  closedAt  DateTime?
}

model WelcomeConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  channelId   String?
  title       String?
  description String?
  color       String?
  thumbnail   String?
  image       String?
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VouchConfig {
  id             String   @id @default(cuid())
  guildId        String   @unique
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled        Boolean  @default(false)
  channelId      String?
  cooldown       Int      @default(60)
  allowedRoleIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vouch {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  reviewerId String
  review     String
  rating     Int
  note       String?
  createdAt  DateTime @default(now())
}

model AutoModConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  bannedWords String[]
  maxMentions Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AntiSpamConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  maxMessages Int      @default(5)
  timeframe   Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AntiRaidConfig {
  id          String   @id @default(cuid())
  guildId     String   @unique
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  threshold   Int     @default(8)
  interval    Int     @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutoResponder {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  trigger   String
  response  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  channelId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId        String
  module        String
  action        String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
}
