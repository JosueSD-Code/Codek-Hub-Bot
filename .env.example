# Core
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://localhost:3001
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
SESSION_SECRET=replace-with-a-strong-random-secret
LOG_LEVEL=info

# Discord
DISCORD_TOKEN=replace-with-real-bot-token
DISCORD_CLIENT_ID=replace-with-real-client-id
